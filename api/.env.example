DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tennisladder?schema=public"

PORT=4000
WEB_APP_URL="http://localhost:5173"

# Reverse proxies in front of the API, for Express's `trust proxy`. Rate limiting keys off req.ip,
# so this must match reality: too low and every caller shares one bucket, too high and a caller can
# spoof their address past the limits. Hosted environments sit behind the Container Apps ingress;
# locally there is no proxy and the default is harmless. GET /api/health echoes the address the API
# resolved for you, which is how to check it. Defaults to 1.
# TRUST_PROXY_HOPS=1

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_TTL_DAYS=30

# Google sign-in. Optional: left blank, the endpoints refuse and the SPA hides the button, which
# is how local dev and staging run. To enable, create an OAuth 2.0 Web application client in
# Google Cloud Console and register GOOGLE_CALLBACK_URL below as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

AZURE_COMMUNICATION_CONNECTION_STRING=""
EMAIL_FROM_ADDRESS="ladder@yourclub.example"
# With no connection string, log the links unsent emails would carry. Defaults to true unless
# NODE_ENV=production.
# LOG_EMAIL_LINKS=true

# IANA timezone the club plays in, used for match times in emails. Defaults to UTC.
# CLUB_TIMEZONE="America/New_York"

# OSRM routing server for match driving times. Defaults to the public demo server.
# ROUTING_BASE_URL="https://router.project-osrm.org"

REGISTRATION_CODE_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
MATCH_REMINDER_LEAD_MINUTES=60
STALE_RESULT_REMINDER_HOURS=24
