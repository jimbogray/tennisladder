DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tennisladder?schema=public"

PORT=4000
WEB_APP_URL="http://localhost:5173"

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_TTL_DAYS=30

# Google sign-in. Optional: left blank, the endpoints refuse and the SPA hides the button, which
# is how local dev and staging run. To enable, create an OAuth 2.0 Web application client in
# Google Cloud Console and register GOOGLE_CALLBACK_URL below as an authorized redirect URI.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/api/auth/google/callback"

AZURE_COMMUNICATION_CONNECTION_STRING=""
EMAIL_FROM_ADDRESS="ladder@yourclub.example"
# Sender number for text messages (phone-number confirmation codes), provisioned on the same Azure
# Communication Services resource. Optional: left blank, SMS stays off even when email works, and
# confirmation codes fall back to the log below.
SMS_FROM_NUMBER=""
# With no provider configured, log what the unsent message would have carried — the links in an
# email, the code in a text. Defaults to true unless NODE_ENV=production. (Named for email because
# it predates SMS; it covers both.)
# LOG_EMAIL_LINKS=true

# OSRM routing server for match driving times. Defaults to the public demo server.
# ROUTING_BASE_URL="https://router.project-osrm.org"

REGISTRATION_CODE_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=60
PHONE_VERIFICATION_TTL_MINUTES=10
MATCH_REMINDER_LEAD_MINUTES=60
STALE_RESULT_REMINDER_HOURS=24
