generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["omitApi"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PLAYER
  ADMIN
}

// The kind of account an invite creates. Not stored on User: redeeming an invite maps it onto
// `role` + `participatesInLadder` (PLAYER = player on the ladder, ADMIN = coach-admin off the
// ladder, PLAYER_ADMIN = admin who also plays).
enum AccountType {
  PLAYER
  ADMIN
  PLAYER_ADMIN
}

enum MatchStatus {
  NEGOTIATING
  DECLINED
  // Challenger pulled their own challenge before it was agreed (vs DECLINED, the opponent
  // rejecting it, and CANCELLED, an already-arranged match being called off).
  WITHDRAWN
  SCHEDULED
  RESULT_PENDING
  RESULT_DISPUTED
  COMPLETED
  CANCELLED
}

enum MatchEventType {
  PROPOSED
  // The proposing side changed its own still-standing offer; the turn does not move.
  AMENDED
  COUNTER_PROPOSED
  ACCEPTED
  DECLINED
  // The challenger pulled their own challenge before it was ever agreed. Distinct from DECLINED
  // (the other player rejecting) and from CANCELLED (calling off an arranged match).
  WITHDRAWN
  // Either player called off an already-scheduled match (ADMIN_CANCELLED is the admin equivalent).
  CANCELLED
  RESULT_SUBMITTED
  // Reporter revised their proposed score before the other player answered.
  RESULT_AMENDED
  RESULT_CONFIRMED
  RESULT_DISPUTED
  ADMIN_OVERRIDE_RESULT
  ADMIN_CANCELLED
}

enum ResultOutcome {
  WON
  LOST
  TIED
}

model User {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String   @unique

  passwordHash String?
  googleId     String? @unique

  // Nullable: required for Players, left null for coach-admins (ustaRating is a player-only concept).
  ustaRating Decimal? @db.Decimal(2, 1)

  role UserRole @default(PLAYER)

  // Orthogonal to `role`: false for coach-admins, who need full admin privileges but must never
  // appear in the ladder, be challenged, or accrue points. Kept as a flag (not a third role value)
  // so a future "player who opts out of the ladder" case is already covered.
  participatesInLadder Boolean @default(true)

  points Int @default(0)

  // Set when an admin removes the user from the team. A soft delete: the row stays so the matches,
  // events and adjustments that reference it keep their history, but the user can no longer sign
  // in and is left out of the team, the ladder and the challenge picker.
  removedAt DateTime?

  registrationCodeId String?           @unique
  registrationCode   RegistrationCode? @relation(fields: [registrationCodeId], references: [id])

  emailVerifiedAt    DateTime?
  profileCompletedAt DateTime?

  // The user's notification number in E.164 (+15551234567). Null means none registered. A number
  // only lands here once a texted code has been confirmed, so this column *is* the verified state
  // — there's no second flag that could drift out of step with it. A number still being confirmed
  // sits on PhoneVerification instead, so an abandoned or mistyped change can't clobber one that
  // already works. Not unique: a household can share a number, and verification already stops
  // anyone attaching a number they can't receive texts on.
  phoneNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  challengedMatches Match[]             @relation("Challenger")
  opponentMatches   Match[]             @relation("Opponent")
  matchEvents       MatchEvent[]
  resultTokens      MatchResultToken[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]
  pointsAdjustments PointsAdjustment[]  @relation("AdjustedUser")
  adjustmentsMade   PointsAdjustment[]  @relation("AdjustingAdmin")
  registrationCodesCreated RegistrationCode[] @relation("RegistrationCodeCreator")
  addresses                UserAddress[]
  matchTravelOrigins       MatchTravelOrigin[]
  phoneVerifications       PhoneVerification[]

  @@map("users")
}

// A texted confirmation code for a phone number a user is registering for notifications. The
// candidate number lives here, not on User, until the code comes back — see User.phoneNumber.
model PhoneVerification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The candidate number, normalized to E.164 before it's stored.
  phoneNumber String

  // sha256 of the six-digit code, never the code itself — the same treatment password reset
  // tokens get. Deliberately not unique: six digits collide across users, and this code is only
  // ever checked against the signed-in user's own newest row, so it's a second factor on their
  // session rather than a credential that stands on its own.
  codeHash String

  // Six digits is cheap to guess in bulk, so a row is spent after a handful of wrong tries
  // instead of staying open until it expires.
  attempts Int @default(0)

  expiresAt  DateTime
  verifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
  @@map("phone_verifications")
}

// A place the user travels to matches from (home, office, …), kept for driving directions and
// travel alerts. Private to its owner: never returned to other players, or to admins.
model UserAddress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // "Home", "Office", or whatever the user typed. Unique per user so a picker never shows two
  // identical choices; the API also compares case-insensitively.
  label   String
  // Free-text postal address, normally filled in from Google Places autocomplete.
  address String

  // Geocoding cache for driving directions, filled lazily on the first travel-plan request — the
  // same lazy pattern Location uses for the weather forecast. `geocodedAddress` is the address the
  // coordinates were looked up from: when it no longer matches `address` the cache is stale.
  // Coordinates are null (with `geocodedAddress` set) when the lookup found nothing, so an
  // unfindable address isn't retried on every request.
  latitude        Float?
  longitude       Float?
  geocodedAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matchTravelOrigins MatchTravelOrigin[]

  @@unique([userId, label])
  @@map("user_addresses")
}

// Where one player is coming from for one match. A separate table rather than columns on Match
// because match rows are shown to both players (and everyone else), and this is private to the
// player who set it. Deleting the address removes the choice rather than leaving a dangling one.
model MatchTravelOrigin {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  // Always the address's owner; kept here so each player has at most one origin per match.
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  addressId String
  address   UserAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([matchId, userId])
  @@index([addressId])
  @@map("match_travel_origins")
}

model RegistrationCode {
  id               String  @id @default(cuid())
  code             String
  createdByAdminId String
  createdByAdmin   User    @relation("RegistrationCodeCreator", fields: [createdByAdminId], references: [id])
  intendedForNote  String?
  // Set when the code was issued by emailing an invite, rather than generated for manual handout.
  invitedEmail     String?
  accountType      AccountType @default(PLAYER)

  usedAt    DateTime?
  usedByUser User?

  createdAt DateTime @default(now())
  expiresAt DateTime

  // Active-code uniqueness ("usedAt" IS NULL) is enforced by a hand-added partial unique index
  // in a migration — see prisma/migrations/*_registration_code_active_unique/migration.sql.
  // Prisma schema syntax has no WHERE clause support for @@unique, so `code` is left unconstrained
  // here; `prisma migrate diff` against this schema will not see the index.

  @@map("registration_codes")
}

model Location {
  id         String    @id @default(cuid())
  name       String    @unique
  // Free-text postal address, normally filled in from Google Places autocomplete. Nullable
  // because locations created before addresses existed have none.
  address    String?
  // Indoor courts are played whatever the weather, so the forecast is left out when arranging a
  // match at one.
  isIndoor   Boolean   @default(false)
  archivedAt DateTime?

  // Geocoding cache for the weather forecast, filled lazily on first forecast request.
  // `geocodedAddress` is the address the coordinates were looked up from: when it no longer
  // matches `address` the cache is stale. Coordinates are null (with `geocodedAddress` set) when
  // the lookup found nothing, so an unfindable address isn't retried on every request.
  latitude        Float?
  longitude       Float?
  geocodedAddress String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches Match[]

  @@map("locations")
}

model Match {
  id String @id @default(cuid())

  challengerId String
  challenger   User   @relation("Challenger", fields: [challengerId], references: [id])
  opponentId   String
  opponent     User   @relation("Opponent", fields: [opponentId], references: [id])

  status MatchStatus @default(NEGOTIATING)

  proposedDateTime   DateTime
  proposedLocationId String
  proposedLocation   Location @relation(fields: [proposedLocationId], references: [id])
  proposedComment    String?

  awaitingResponseFromUserId String
  lastActionAt               DateTime @default(now())

  scheduledDateTime DateTime?

  // Reason given when a scheduled match was called off. Mirrored from the CANCELLED MatchEvent
  // so the list views can show it without loading each match's event history.
  cancellationComment String?

  resultReportedByUserId String?
  // A tie has no winner or loser, so winnerId/loserId stay null — this flag is what distinguishes
  // a completed tie from a match with no reported result.
  isTie                  Boolean   @default(false)
  winnerId               String?
  loserId                String?
  pointsAwarded          Int?
  resultConfirmedAt      DateTime?
  isAdminOverride        Boolean   @default(false)

  reminderSentAt            DateTime?
  staleResultReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events        MatchEvent[]
  resultTokens  MatchResultToken[]
  travelOrigins MatchTravelOrigin[]

  @@index([status])
  @@map("matches")
}

model MatchEvent {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id])

  type        MatchEventType
  actorUserId String?
  actor       User?          @relation(fields: [actorUserId], references: [id])

  // Negotiation-event snapshot fields
  snapshotDateTime   DateTime?
  snapshotLocationId String?
  comment            String?

  // Result-event field
  resultOutcome ResultOutcome?

  createdAt DateTime @default(now())

  @@index([matchId, createdAt])
  @@map("match_events")
}

model MatchResultToken {
  id      String @id @default(cuid())
  matchId String
  match   Match  @relation(fields: [matchId], references: [id])
  userId  String
  user    User   @relation(fields: [userId], references: [id])

  outcome ResultOutcome
  token   String        @unique

  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@unique([matchId, userId, outcome])
  @@map("match_result_tokens")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id])
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@map("password_reset_tokens")
}

model PointsAdjustment {
  id                String @id @default(cuid())
  userId            String
  user              User   @relation("AdjustedUser", fields: [userId], references: [id])
  adjustedByAdminId String
  adjustedByAdmin   User   @relation("AdjustingAdmin", fields: [adjustedByAdminId], references: [id])

  previousPoints Int
  newPoints      Int
  reason         String?

  createdAt DateTime @default(now())

  @@map("points_adjustments")
}
