VITE_API_BASE_URL="http://localhost:4000/api"

# Browser key for the Google Maps JavaScript API (Places autocomplete) and the Maps Embed API.
# Enable "Maps JavaScript API", "Places API (New)" and "Maps Embed API" on the key's project, and
# restrict it by HTTP referrer — this value ships in the client bundle. Leave blank to fall back to
# a plain address text input with no map.
VITE_GOOGLE_MAPS_API_KEY=""
